# AgencyOS Environment Configuration
# Copy this to .env and fill in actual values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
APP_VERSION=1.0.0
PORT=3000
API_PREFIX=api/v1

# ============================================
# DATABASE (PostgreSQL via Prisma)
# ============================================
DATABASE_URL=postgresql://user:pass@localhost:5432/agencyos?schema=public
DIRECT_URL=postgresql://user:pass@localhost:5432/agencyos?schema=public

# ============================================
# REDIS
# ============================================
# Standalone mode (default)
REDIS_URL=redis://localhost:6379

# Cluster mode (for HA)
# REDIS_MODE=cluster
# REDIS_CLUSTER_NODES="host1:6379,host2:6379,host3:6379"
# REDIS_MAX_RETRIES=3
# REDIS_ENABLE_READY_CHECK=true
# REDIS_LAZY_CONNECT=true
# REDIS_FORCE_PATH_STYLE=false

# ============================================
# JWT & AUTH
# ============================================
JWT_ACCESS_SECRET=replace-with-strong-secret-64-chars-min
JWT_REFRESH_SECRET=replace-with-strong-secret-64-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=agencyos
JWT_AUDIENCE=agencyos-api

# ============================================
# VAULT (HashiCorp Vault for secrets)
# ============================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=replace-with-vault-token
VAULT_MOUNT_PATH=secret
VAULT_KV_VERSION=2

# ============================================
# AI SERVICE
# ============================================
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_SECRET=replace-with-ai-service-secret
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# ============================================
# STORAGE (S3 / R2 / MinIO)
# ============================================
STORAGE_PROVIDER=s3
STORAGE_REGION=us-east-1
STORAGE_BUCKET=agencyos-assets
STORAGE_ACCESS_KEY_ID=replace-with-access-key
STORAGE_SECRET_ACCESS_KEY=replace-with-secret-key
# For R2/MinIO
# STORAGE_ENDPOINT=https://accountid.r2.cloudflarestorage.com
# STORAGE_FORCE_PATH_STYLE=true
# STORAGE_PUBLIC_URL_BASE=https://assets.agencyos.com

# ============================================
# EMAIL SERVICE
# ============================================
EMAIL_PROVIDER=console
# Options: sendgrid, mailgun, ses, resend, nodemailer, console

# SendGrid
# SENDGRID_API_KEY=SG.xxx
# SENDGRID_FROM_EMAIL=noreply@agencyos.com

# Mailgun
# MAILGUN_API_KEY=xxx
# MAILGUN_DOMAIN=mg.agencyos.com
# MAILGUN_FROM_EMAIL=noreply@mg.agencyos.com

# AWS SES
# AWS_SES_ACCESS_KEY_ID=xxx
# AWS_SES_SECRET_ACCESS_KEY=xxx
# AWS_SES_REGION=us-east-1
# AWS_SES_FROM_EMAIL=noreply@agencyos.com

# Resend
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=noreply@agencyos.com

# Nodemailer (SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=xxx
# SMTP_PASS=xxx
# SMTP_FROM_EMAIL=noreply@agencyos.com
# SMTP_SECURE=false

# ============================================
# MULTI-REGION FAILOVER
# ============================================
FAILOVER_ENABLED=false
PRIMARY_REGION=us-east-1
SECONDARY_REGIONS=eu-west-1,us-west-2
IS_PRIMARY_REGION=true

# Health check intervals
FAILOVER_HEALTH_CHECK_INTERVAL=30000
FAILOVER_FAILURE_THRESHOLD=3
FAILOVER_RECOVERY_THRESHOLD=2

# DNS Provider for failover
FAILOVER_DNS_PROVIDER=cloudflare
FAILOVER_DNS_ZONE_ID=replace-with-zone-id
FAILOVER_DNS_RECORD_NAME=api
FAILOVER_NOTIFY_WEBHOOK=https://hooks.slack.com/services/xxx

# Region-specific endpoints (for health checks)
PRIMARY_API_ENDPOINT=https://api.agencyos.com
SECONDARY_EU_WEST_1_API_ENDPOINT=https://api-eu.agencyos.com
SECONDARY_US_WEST_2_API_ENDPOINT=https://api-usw2.agencyos.com

# Database hosts for failover
PRIMARY_DB_HOST=primary-db.cluster-xxx.us-east-1.rds.amazonaws.com
SECONDARY_EU_WEST_1_DB_HOST=secondary-db.cluster-xxx.eu-west-1.rds.amazonaws.com
SECONDARY_US_WEST_2_DB_HOST=secondary-db.cluster-xxx.us-west-2.rds.amazonaws.com

# ============================================
# CORS & SECURITY
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.agencyos.com
CSRF_SECRET=replace-with-csrf-secret

# ============================================
# RATE LIMITING
# ============================================
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=debug
SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ENVIRONMENT=development

# ============================================
# CLOUDFLARE (for DNS failover)
# ============================================
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-token
CLOUDFLARE_ZONE_ID=replace-with-zone-id
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_SWAGGER=true
ENABLE_METRICS=true
ENABLE_TRACING=false