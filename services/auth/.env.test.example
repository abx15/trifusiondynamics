# Test Environment Configuration for Auth Service
# Copy this file to .env.test (or set these env vars in your test CI pipeline).
#
# CRITICAL: This database must NEVER point to a production database.
# The test setup (services/auth/test/setup.ts) enforces NODE_ENV != production.

# Test database — must be a LOCAL or isolated dev database.
# Example: PostgreSQL running in Docker on localhost
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trifusion_test"

# If you need to override the main DATABASE_URL for unit tests
# (e.g. when the PrismaService tries to connect during module init):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trifusion_test"

# Redis is optional for tests
REDIS_URL=""

# JWT secrets (test-only — use strong random values)
JWT_ACCESS_SECRET="test-access-secret-key-for-unit-tests-only-32-chars-min"
JWT_REFRESH_SECRET="test-refresh-secret-key-for-unit-tests-only-32-chars-min"

# Node environment — tests MUST NOT use "production"
NODE_ENV="test"

# Test ports
PORT=8000
