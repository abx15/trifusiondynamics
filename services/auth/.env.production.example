# Auth API - Production Environment Configuration Example
# https://trifusiondynamics-api.onrender.com
# 
# IMPORTANT: This is an example file only. Do not commit actual secrets.
# Copy this file to .env.production and replace the placeholders with actual values.
# Configure actual secrets in Render Environment Variables, not in this file.

# Port Configuration
PORT=8000

# Database Configuration
DATABASE_URL=postgresql://user:password@ep-xyz.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xyz.aws.neon.tech/neondb?sslmode=require
MONGODB_URL=mongodb+srv://user:password@cluster0.xyz.mongodb.net/agency_analytics?retryWrites=true&w=majority
REDIS_URL=redis://default:password@xyz.upstash.io:6379

# JWT Configuration (Generate 64+ character random strings)
JWT_ACCESS_SECRET=your-64-character-random-secret-key-here
JWT_REFRESH_SECRET=your-64-character-random-secret-key-here

# Admin Configuration
ADMIN_EMAIL=admin@trifusiondynamics.com
ADMIN_PASSWORD=your-secure-admin-password-here
DEFAULT_TEMP_PASSWORD=Welcome@123

# CORS Configuration (Production Vercel domains)
CORS_ALLOWED_ORIGINS=https://trifusiondynamics.vercel.app,https://trifusiondynamicsadmin.vercel.app
COOKIE_DOMAIN=

# AI Service Configuration
AI_SERVICE_URL=https://trifusiondynamics-ai-api.onrender.com
AI_SERVICE_SECRET=your-internal-service-secret-here

# AI API Keys (Optional - for AI features)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Sentry (Optional - for error tracking)
SENTRY_DSN=your-sentry-dsn-here

# Environment
NODE_ENV=production
