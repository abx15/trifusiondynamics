# Environment Configuration for Production
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Server
PORT=8000
NODE_ENV=production

# Database (Required - Get from Render Dashboard)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Redis (Optional - Get from Render/Upstash)
REDIS_URL="redis://default:password@host:6379"

# MongoDB (Optional - Get from MongoDB Atlas)
MONGODB_URL="mongodb+srv://user:password@cluster.mongodb.net/dbname"

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET="your-64-char-random-secret-here-change-in-production"
JWT_REFRESH_SECRET="your-64-char-random-secret-here-change-in-production"

# Admin Configuration
ADMIN_EMAIL="admin@trifusiondynamics.com"
ADMIN_PASSWORD="ChangeThisPassword123!"
DEFAULT_TEMP_PASSWORD="Welcome@123"

# CORS Configuration (Update with your actual frontend URLs)
CORS_ALLOWED_ORIGINS="https://your-admin.vercel.app,https://your-client.vercel.app,https://your-web.vercel.app"
COOKIE_DOMAIN=

# Frontend URLs (Update with your actual deployed URLs)
NEXT_PUBLIC_API_URL="https://your-backend.onrender.com/api"
NEXT_PUBLIC_AUTH_GATEWAY_URL="https://your-auth.vercel.app"
NEXT_PUBLIC_ADMIN_DASHBOARD_URL="https://your-admin.vercel.app"
NEXT_PUBLIC_CLIENT_PORTAL_URL="https://your-client.vercel.app"
NEXT_PUBLIC_AGENCY_WEB_URL="https://your-web.vercel.app"

# AI Services (Optional)
ANTHROPIC_API_KEY="your-anthropic-key"
OPENAI_API_KEY="your-openai-key"
GEMINI_API_KEY="your-gemini-key"
AI_SERVICE_URL="http://localhost:8001"
AI_SERVICE_SECRET="change-me-in-production"

# Sentry (Optional)
SENTRY_DSN=""
