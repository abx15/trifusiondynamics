# Environment Configuration for Production
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Server
PORT=8000
NODE_ENV=production

# Database (Required - Neon PostgreSQL)
# WARNING: Do NOT commit real credentials. Placeholders only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Database Read Replicas (Optional - for analytics/reporting queries)
# Comma-separated list of read replica URLs
# DATABASE_READ_REPLICA_URLS="postgresql://USER:PASSWORD@READ-REPLICA-1.neon.tech/neondb?sslmode=require,postgresql://USER:PASSWORD@READ-REPLICA-2.neon.tech/neondb?sslmode=require"

# PgBouncer Connection Pooling (Optional - for serverless/edge environments)
# Set to "true" to enable PgBouncer transaction pool mode
# Requires: prepared statements disabled (handled automatically)
# DATABASE_USE_PGBOUNCER="false"
# Optional: explicit write URL (useful when using PgBouncer for reads but direct for writes)
# DATABASE_WRITE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# MongoDB (Optional - TrifusionDB)
MONGODB_URL="mongodb+srv://USER:PASSWORD@cluster.mongodb.net/"

# Redis (Required)
REDIS_URL="redis://default:PASSWORD@HOST:PORT"

# JWT Secrets (Generate 64+ char random secrets. NEVER reuse the old defaults.)
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret-at-least-32-characters"

# Admin Configuration
ADMIN_EMAIL="admin@trifusiondynamics.com"
ADMIN_PASSWORD="change-this-to-a-strong-admin-password"
DEFAULT_TEMP_PASSWORD="change-this-to-a-strong-temp-password"

# CORS Configuration (Production)
CORS_ALLOWED_ORIGINS="https://trifusiondynamics.vercel.app,https://trifusiondynamicsadmin.vercel.app,https://trifusiondynamics-ai-api.onrender.com"
COOKIE_DOMAIN=.vercel.app

# Frontend URLs (Production)
NEXT_PUBLIC_API_URL="https://trifusiondynamics-api.onrender.com/api"
NEXT_PUBLIC_AUTH_GATEWAY_URL="https://trifusiondynamics-api.onrender.com"
NEXT_PUBLIC_ADMIN_DASHBOARD_URL="https://trifusiondynamicsadmin.vercel.app"
NEXT_PUBLIC_CLIENT_PORTAL_URL="https://trifusiondynamics.vercel.app"
NEXT_PUBLIC_AGENCY_WEB_URL="https://trifusiondynamics.vercel.app"
NEXT_PUBLIC_AI_SERVICE_URL="https://trifusiondynamics-ai-api.onrender.com"

# AI Services (Optional)
AI_SERVICE_URL="https://trifusiondynamics-ai-api.onrender.com"
AI_SERVICE_SECRET="change-me-in-production"

# Sentry (Optional)
SENTRY_DSN=""

# Secret Provider Configuration
# Options: 'env' (default), 'vault', 'aws'
# Priority order: vault > aws > env
# Multiple providers can be active; the first healthy one is used.
SECRET_PROVIDER="env"

# HashiCorp Vault Configuration (if SECRET_PROVIDER=vault)
VAULT_URL="https://vault.example.com:8200"
VAULT_TOKEN=""  # Or use AppRole: VAULT_ROLE_ID + VAULT_SECRET_ID
VAULT_ROLE=""   # AppRole name (if using AppRole auth)
VAULT_ROLE_ID=""
VAULT_SECRET_ID=""
VAULT_MOUNT_PATH="secret"  # KV mount path
VAULT_KV_VERSION="2"       # 1 or 2

# AWS Secrets Manager Configuration (if SECRET_PROVIDER=aws)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""       # Optional if using IAM role
AWS_SECRET_ACCESS_KEY=""   # Optional if using IAM role
AWS_SESSION_TOKEN=""       # Optional for temporary credentials
AWS_SECRETS_PREFIX="agencyos/"

# Secret Rotation
# Check for secret rotations every 5 minutes (300000ms)
SECRET_ROTATION_CHECK_INTERVAL_MS="300000"
