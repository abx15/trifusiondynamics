# AI Service Production Environment Configuration Example
# IMPORTANT: This is an example file only. Do not commit actual secrets.
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Environment
ENVIRONMENT=production

# AI API Keys (Required for AI features to work)
# Get these from: https://console.anthropic.com, https://platform.openai.com, https://makersuite.google.com
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
GEMINI_API_KEY=your-gemini-key

# Database Configuration (Optional - if AI service needs direct DB access)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# CORS Configuration (Remove localhost URLs for production)
CORS_ALLOWED_ORIGINS=https://trifusiondynamics.vercel.app,https://trifusiondynamicsadmin.vercel.app,https://trifusiondynamics-ai-api.onrender.com

# Internal Secret (For service-to-service communication)
# Generate with: openssl rand -hex 32
AI_SERVICE_SECRET=replace-with-a-32-char-hex-secret

# Sentry (Optional - for error tracking)
SENTRY_DSN=
