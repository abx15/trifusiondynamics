# AI Service - Production Environment Configuration Example
# https://trifusiondynamics-ai-api.onrender.com
#
# IMPORTANT: This is an example file only. Do not commit actual secrets.
# Copy this file to .env.production and replace the placeholders with actual values.
# Configure actual secrets in Render Environment Variables, not in this file.

# Environment
ENVIRONMENT=production

# AI API Keys (At least one key is required for AI functionality)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Database Configuration (Optional - if AI service needs direct DB access)
DATABASE_URL=postgresql://user:password@localhost:5432/trifusion_db

# CORS Configuration (Allow requests from Auth API and frontends)
CORS_ALLOWED_ORIGINS=https://trifusiondynamics-api.onrender.com,https://trifusiondynamics.vercel.app,https://trifusiondynamicsadmin.vercel.app

# Internal Secret (For service-to-service communication)
AI_SERVICE_SECRET=your-internal-service-secret-here

# Sentry (Optional - for error tracking)
SENTRY_DSN=your-sentry-dsn-here
