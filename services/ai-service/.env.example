# AI Service Configuration
ENVIRONMENT=development

# AI API Keys (Optional - for AI features)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Database Configuration (Optional - if AI service needs direct DB access)
DATABASE_URL=postgresql://user:password@localhost:5432/trifusion_db

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Internal Secret (For service-to-service communication)
AI_SERVICE_SECRET=change-me-in-production

# Sentry (Optional - for error tracking)
SENTRY_DSN=your-sentry-dsn-here
