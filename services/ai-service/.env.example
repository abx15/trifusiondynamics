# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
ENVIRONMENT=development

# AI API Keys (Optional - for AI features)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
